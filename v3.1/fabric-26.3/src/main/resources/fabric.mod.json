  "authors": ["wanstu"],
  "environment": "*",
  "entrypoints": {
    "main": ["com.wanstu.cartographv3.FabricCartograph"],
    "client": ["com.wanstu.cartographv3.FabricCartographClient"]
  },
  "mixins": ["cartograph_v3.mixins.json", "cartograph_v3.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
